# ==============================================================================
# The Movement — Environment Configuration (.env.example)
# Copy this file to .env.local (or .env) and populate with your credentials.
# ==============================================================================

# ── BACKEND DATA SOURCE SWITCH ───────────────────────────────────────────────
# Set to "false" to connect to real Supabase PostgreSQL backend.
# Set to "true" to run in client-side in-memory mock mode (offline/demo mode).
NEXT_PUBLIC_USE_MOCKS=false

# ── APPLICATION URL ──────────────────────────────────────────────────────────
# Canonical URL of the application (used for invite code sharing and metadata)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── SUPABASE BACKEND CREDENTIALS ─────────────────────────────────────────────
# Supabase Project HTTPS URL (for PostgREST API and Realtime WebSocket)
NEXT_PUBLIC_SUPABASE_PROJECT_URL=https://your-project-id.supabase.co

# PostgreSQL Direct Connection String (Optional, for migrations or direct pool)
NEXT_PUBLIC_SUPABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# Supabase Public Anonymous Key (safe for client-side queries with RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (SERVER-SIDE ONLY — NEVER expose to browser)
# Used in /api/* route handlers for admin triggers, storage buckets, and audit log
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
